{
  "name": "@ultrafilterai/ultrafilter-cli",
  "version": "0.1.6",
  "description": "Ultrafilter agent-first CLI (TypeScript rewrite)",
  "type": "commonjs",
  "private": false,
  "bin": {
    "uf": "bin/uf.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "tsup src/main.ts --format cjs --target node20 --sourcemap --clean --out-dir dist",
    "prepare": "npm run build",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^2.1.8"
  }
}
